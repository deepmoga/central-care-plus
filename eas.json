{
  "cli": {
    "version": ">= 16.28.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://homecareclaimportal.com.au/api",
        "EXPO_PUBLIC_BASE_URL": "https://homecareclaimportal.com.au/"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://homecareclaimportal.com.au/api",
        "EXPO_PUBLIC_BASE_URL": "https://homecareclaimportal.com.au/"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://homecareclaimportal.com.au/api",
        "EXPO_PUBLIC_BASE_URL": "https://homecareclaimportal.com.au/"
      }
    }
  },
  "submit": {
    "production": {}
  }
}